{
  "name": "@contraagent/api",
  "version": "0.3.0",
  "description": "Typed client for the contraagent monitor API: generated types, REST client, live feeds and the run state they fold into",
  "license": "MIT",
  "keywords": [
    "contraagent",
    "coding-agent",
    "monitor",
    "openapi",
    "client",
    "typescript"
  ],
  "homepage": "https://t-tani.github.io/contraagent/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-tani/contraagent.git",
    "directory": "web/packages/api"
  },
  "bugs": {
    "url": "https://github.com/t-tani/contraagent/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
