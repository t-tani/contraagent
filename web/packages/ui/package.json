{
  "name": "@contraagent/ui",
  "version": "0.10.1",
  "description": "Web components for the contraagent monitor: transcripts, task tables, the journal, plans, contracts. Framework-free (Lit), typed by @contraagent/api",
  "license": "MIT",
  "keywords": [
    "contraagent",
    "coding-agent",
    "monitor",
    "web-components",
    "lit",
    "custom-elements"
  ],
  "homepage": "https://t-tani.github.io/contraagent/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-tani/contraagent.git",
    "directory": "web/packages/ui"
  },
  "bugs": {
    "url": "https://github.com/t-tani/contraagent/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./monitor": {
      "source": "./src/define/monitor.ts",
      "types": "./dist/define/monitor.d.ts",
      "default": "./dist/define/monitor.js"
    },
    "./overview": {
      "source": "./src/define/overview.ts",
      "types": "./dist/define/overview.d.ts",
      "default": "./dist/define/overview.js"
    },
    "./pipeline-graph": {
      "source": "./src/define/pipeline-graph.ts",
      "types": "./dist/define/pipeline-graph.d.ts",
      "default": "./dist/define/pipeline-graph.js"
    },
    "./task-view": {
      "source": "./src/define/task-view.ts",
      "types": "./dist/define/task-view.d.ts",
      "default": "./dist/define/task-view.js"
    },
    "./transcript": {
      "source": "./src/define/transcript.ts",
      "types": "./dist/define/transcript.d.ts",
      "default": "./dist/define/transcript.js"
    },
    "./task-table": {
      "source": "./src/define/task-table.ts",
      "types": "./dist/define/task-table.d.ts",
      "default": "./dist/define/task-table.js"
    },
    "./journal-table": {
      "source": "./src/define/journal-table.ts",
      "types": "./dist/define/journal-table.d.ts",
      "default": "./dist/define/journal-table.js"
    },
    "./contracts": {
      "source": "./src/define/contracts.ts",
      "types": "./dist/define/contracts.d.ts",
      "default": "./dist/define/contracts.js"
    },
    "./definitions": {
      "source": "./src/define/definitions.ts",
      "types": "./dist/define/definitions.d.ts",
      "default": "./dist/define/definitions.js"
    },
    "./kpis": {
      "source": "./src/define/kpis.ts",
      "types": "./dist/define/kpis.d.ts",
      "default": "./dist/define/kpis.js"
    },
    "./timeline": {
      "source": "./src/define/timeline.ts",
      "types": "./dist/define/timeline.d.ts",
      "default": "./dist/define/timeline.js"
    },
    "./procs": {
      "source": "./src/define/procs.ts",
      "types": "./dist/define/procs.d.ts",
      "default": "./dist/define/procs.js"
    },
    "./adapters": {
      "source": "./src/adapters/index.ts",
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./words": {
      "source": "./src/words/index.ts",
      "types": "./dist/words/index.d.ts",
      "default": "./dist/words/index.js"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./localize": {
      "source": "./src/core/i18n.ts",
      "types": "./dist/core/i18n.d.ts",
      "default": "./dist/core/i18n.js"
    },
    "./bundle": "./dist/contraagent-ui.js",
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "docs",
    "!docs/images",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/define/*.js",
    "./dist/elements/**",
    "./src/index.ts",
    "./src/define/*.ts",
    "./src/elements/**"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && vite build && cem analyze --litelement --globs 'src/elements/**/*.ts' --exclude 'src/elements/**/graph/**' 'src/elements/**/pipeline-graph/**' 'src/elements/**/*-model.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p docs",
    "i18n": "lit-localize extract && lit-localize build",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@contraagent/api": "workspace:*",
    "@contraagent/elements": "workspace:*"
  },
  "peerDependencies": {
    "@lit/localize": "^0.12.2",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lit/localize": "^0.12.2",
    "@lit/localize-tools": "^0.8.2",
    "lit": "^3.3.3",
    "terser": "^5.51.2",
    "vite": "^8.3.1"
  }
}
