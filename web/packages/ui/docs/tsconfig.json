{
  // The examples are documentation: they compile against the packages as they are.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@contraagent/api": ["../../api/src/index.ts"],
      "@contraagent/elements": ["../../elements/src/index.ts"],
      "@contraagent/elements/*": ["../../elements/src/*"],
      "@contraagent/ui": ["../src/index.ts"]
    }
  },
  "include": ["examples/**/*.ts"]
}
