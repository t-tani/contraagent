  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@contraagent/elements": ["../src/index.ts"],
      "@contraagent/elements/segmented/define": ["../src/define/segmented.ts"],
