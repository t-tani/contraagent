  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "docs",
    "!docs/images",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/define/*.js",
    "./src/define/*.ts"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && cem analyze --litelement --globs 'src/*/{segmented,data-table,layered-graph,mark-matrix,stat-tiles,lanes,column-chart,line-chart,heatmap,bar-chart,check-table,transcript,json-tree,cae-markdown,code,tree,count,elapsed}.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p docs"
  },
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "lit": "^3.3.3"
  }
