{
  "name": "contraagent-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen": "pnpm --filter @contraagent/api gen",
    "dev": "pnpm --filter @contraagent/monitor-app dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm gen --check && pnpm --filter @contraagent/ui i18n:check && pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "pnpm build && playwright test",
    "check:dist": "tsc -p apps/monitor/tsconfig.dist.json && node scripts/size.mjs && node consumer/consumer.test.mjs",
    "docs": "pnpm --filter @contraagent/docs dev",
    "tarballs": "pnpm --filter \"./packages/**\" build && node scripts/tarballs.mjs",
    "i18n": "pnpm --filter @contraagent/ui i18n"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-lit": "^2.3.1",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
