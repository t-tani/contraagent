---
// A generic element live: the module packages/elements/docs/examples/<name>.ts
// mounts it with its own hand-written data (`mount(host)`). `theme` is a
// built-in theme (`data-ca-theme`), `custom` a class of the package's
// docs/examples/theme.css (a theme of one's own) on top of it; what an element
// sends shows under it. `source`: the module's text under it, open, folded
// (`details`), or not at all (`none`: the page quotes it itself).
import { Code } from '@astrojs/starlight/components';
import { repoFile } from '../lib/repo';

interface Props {
  name: string;
  height?: string;
  theme?: string;
  custom?: string;
  caption?: string;
  source?: 'open' | 'details' | 'none';
}
const { name, height, theme = 'contraagent-dark', custom, caption, source = 'open' } = Astro.props;
const file = `web/packages/elements/docs/examples/${name}.ts`;
---

<figure class:list={['ca-demo', custom]} data-ca-theme={theme} style={height ? `--h:${height}` : undefined}>
  <div class="ca-demo-frame" data-cae-example={name}></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
{source === 'open' && <Code code={repoFile(file)} lang="ts" title={file} />}
{
  source === 'details' && (
    <details class="ca-source">
      <summary>
        Source: <code>{file}</code>
      </summary>
      <Code code={repoFile(file)} lang="ts" title={file} />
    </details>
  )
}

<script>
  import { adoptThemes } from '@contraagent/elements/themes';

  const modules = import.meta.glob<{ mount: (host: HTMLElement) => void }>('../../../../packages/elements/docs/examples/*.ts');
  adoptThemes(document);
  for (const host of document.querySelectorAll<HTMLElement>('[data-cae-example]')) {
    const load = modules[`../../../../packages/elements/docs/examples/${host.dataset['caeExample']}.ts`];
    if (!load) continue;
    void load().then((m) => m.mount(host));
    for (const name of ['cae-activate', 'cae-select', 'cae-sort', 'cae-change', 'cae-action', 'cae-drill', 'cae-view-change']) {
      host.addEventListener(name, (e) => host.closest('figure')?.setAttribute('data-last-event', `${name} ${JSON.stringify((e as CustomEvent).detail)}`));
    }
  }
</script>
