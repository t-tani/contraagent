---
// The live elements under an element topic's title (its `live` front matter,
// from scripts/collect.py `LIVE`): each drawn as the gallery draws it, then
// links to the elements' reference entries and to the gallery.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Demo from './Demo.astro';
import Example from './Example.astro';
import ElementLinks from './ElementLinks.astro';

interface Figure {
  demo?: string;
  props?: Record<string, string>;
  example?: string;
  image?: string;
  alt?: string;
  tags: string[];
  height?: string;
  theme?: string;
  custom?: string;
  caption?: string;
}
interface Props { figures: Figure[] }
const { figures } = Astro.props;

// The screenshots a figure may show (`docs/assets/readme/`), resolved when the site is built.
const pictures = import.meta.glob<{ default: ImageMetadata }>('../../../../../docs/assets/readme/*.png', { eager: true });
const picture = (path: string) => {
  const found = pictures[`../../../../../${path}`];
  if (!found) throw new Error(`LiveFigures: no image ${path}`);
  return found.default;
};
const tags = [...new Set(figures.flatMap((f) => f.tags))];
---

<div class="ca-live not-content">
  {
    figures.map((f) =>
      f.demo ? (
        <Demo tag={f.demo} props={f.props ?? {}} height={f.height} theme={f.theme} custom={f.custom} caption={f.caption} />
      ) : f.example ? (
        <Example name={f.example} height={f.height} theme={f.theme} custom={f.custom} caption={f.caption} source="none" />
      ) : (
        <figure class="ca-picture">
          <Image src={picture(f.image!)} alt={f.alt ?? ''} widths={[800, 1600]} sizes="(min-width: 72rem) 48rem, 100vw" />
          <figcaption>{f.alt}</figcaption>
        </figure>
      ),
    )
  }
  <ElementLinks tags={tags} links={[{ href: '/elements/', label: 'Element gallery' }]} />
</div>
