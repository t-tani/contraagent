---
// The landing page's replay of the demo pipeline's showcase run (./replay.ts plays it).
import { code, TASKS, timeline } from './timeline';

const lines = code();
const data = timeline();
const { t0, t1, plan, moments } = data;
const clock = (s: number): string => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const done = plan.nodes.filter((n) => n.state === 'done').length;
const file = TASKS.split('/').slice(-3).join('/');
/** The lines tasks were created on: only these have a count of running tasks (./replay.ts writes it). */
const taskLines = new Set(plan.nodes.map((n) => n.flow?.at(-1)?.line ?? 0));
/** The panels a narrow screen shows one at a time; the numbers stay under them. */
const TABS = [
  { id: 'code', name: 'Code' },
  { id: 'graph', name: 'Graph' },
  { id: 'transcript', name: 'Transcript' },
];
---

<section class="rr not-content" data-run-replay data-ca-theme="contraagent-dark" aria-labelledby="rr-title">
  <script is:inline>
    // Before the first paint: the replay starts from its first frame (with reduced motion it shows the last).
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('rr-js');
  </script>
  <h2 id="rr-title" class="rr-title">A run of the demo pipeline, replayed</h2>

  <div class="rr-window">
    <div class="rr-bar">
      <span class="rr-status" aria-hidden="true"><span class="rr-status-run">Run {data.run} | </span><span class="rr-status-now">finished | {done} of {plan.nodes.length} done | {clock(t1 - t0)}</span></span>
      <button class="rr-toggle" type="button" data-state="playing">Pause</button>
      <div class="rr-progress" aria-hidden="true"><div class="rr-progress-bar"></div></div>
    </div>

    {/* A narrow screen: one panel at a time (./replay.ts makes these tabs and follows the run with them). */}
    <div class="rr-tabs" role="tablist" aria-label="Panels of the replay">
      {TABS.map((t, i) => <button type="button" role="tab" id={`rr-tab-${t.id}`} aria-controls={`rr-panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-panel={t.id}>{t.name}</button>)}
    </div>

    <div class="rr-grid">
      <div class="rr-pane rr-code" id="rr-panel-code" data-panel="code">
        <div class="rr-head"><span class="rr-head-title">{file}</span></div>
        <div class="rr-pre" role="region" tabindex="0" data-scroll="x" aria-label={`Lines of ${file}`}>{
          lines.map((l) =>
            l.n ? (
              <div class="rr-line" data-n={l.n}><span class="rr-n" aria-hidden="true">{l.n}</span><code set:html={l.html || ' '} />{taskLines.has(l.n) && <span class="rr-badge" aria-hidden="true" />}</div>
            ) : (
              <div class="rr-line rr-gap" aria-hidden="true"><span class="rr-n">⋮</span><code> </code></div>
            ),
          )
        }</div>
      </div>

      <div class="rr-pane rr-graph" id="rr-panel-graph" data-panel="graph">
        <div class="rr-head"><code class="rr-head-tag">&lt;ca-pipeline-graph&gt;</code></div>
        <div class="rr-body"><ca-pipeline-graph></ca-pipeline-graph></div>
      </div>

      <div class="rr-pane rr-kpis">
        <div class="rr-head"><code class="rr-head-tag">&lt;ca-kpis&gt;</code></div>
        <div class="rr-body" data-scroll="x"><ca-kpis></ca-kpis></div>
      </div>

      <div class="rr-pane rr-transcript" id="rr-panel-transcript" data-panel="transcript">
        <div class="rr-head"><span class="rr-head-title rr-spot-name">{data.spots[0]?.name}</span><code class="rr-head-tag">&lt;ca-transcript&gt;</code></div>
        <div class="rr-body"><ca-transcript></ca-transcript></div>
      </div>
    </div>
  </div>

  {/* The moments of the run: the one the replay has reached is lit. */}
  <ol class="rr-moments" aria-label="What happened in the run">
  {
    moments.map((m) => (
      <li class="rr-moment" data-at={m.at.toFixed(2)}>
        <span class="rr-at">{clock(m.at)}</span>
        <span class="rr-text">{m.text}</span>
      </li>
    ))
  }
  </ol>

  <script type="application/json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</section>

<script>
  import './replay';
</script>

<style>
  .rr {
    --rr-radius: 14px;
    --rr-mono: var(--sl-font-mono, var(--sl-font-system-mono));
    margin: 0 0 4rem;
  }
  .rr-title {
    font-size: var(--sl-text-2xl);
    line-height: 1.2;
    margin: 0 0 1rem;
    color: var(--sl-color-white);
  }

  .rr-window {
    position: relative;
    background: var(--ca-backdrop);
    color: var(--ca-text);
    border: 1px solid var(--ca-line);
    border-radius: var(--rr-radius);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ca-text) 6%, transparent) inset, 0 30px 80px -30px color-mix(in srgb, var(--ca-shadow) 80%, transparent);
    overflow: hidden;
    font: 13px/1.5 var(--sl-font, var(--sl-font-system));
  }
  .rr-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--ca-line);
    background: color-mix(in srgb, var(--ca-card) 70%, transparent);
  }
  .rr-status {
    flex: 1;
    min-width: 0;
    font: 12px/1.4 var(--rr-mono);
    color: var(--ca-text-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rr[data-phase='running'] .rr-status::before,
  .rr[data-phase='finished'] .rr-status::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    vertical-align: 0;
    background: var(--ca-status-running);
    box-shadow: 0 0 0 0 var(--ca-status-running);
    animation: rr-pulse 1.6s ease-out infinite;
  }
  .rr[data-phase='finished'] .rr-status::before { background: var(--ca-status-done); animation: none; }
  .rr-paused .rr-status::before { animation-play-state: paused; }
  @keyframes rr-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ca-status-running) 60%, transparent); }
    100% { box-shadow: 0 0 0 8px transparent; }
  }
  .rr-toggle {
    flex: none;
    font: 600 12px/1 var(--sl-font, var(--sl-font-system));
    color: var(--ca-text);
    background: var(--ca-raise);
    border: 1px solid var(--ca-line2);
    border-radius: 999px;
    padding: 6px 12px 6px 28px;
    cursor: pointer;
    position: relative;
  }
  .rr-toggle::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 50%;
    width: 9px;
    height: 10px;
    transform: translateY(-50%);
    background: currentColor;
    clip-path: polygon(0 0, 35% 0, 35% 100%, 0 100%, 0 0, 65% 0, 100% 0, 100% 100%, 65% 100%, 65% 0);
  }
  .rr-toggle[data-state='paused']::before { clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .rr-toggle[data-state='ended']::before {
    width: 10px;
    height: 10px;
    background: none;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    box-sizing: border-box;
    clip-path: none;
  }
  .rr-toggle:hover { background: var(--ca-panel2); }
  .rr-toggle:focus-visible { outline: var(--ca-focus-width) solid var(--ca-focus); outline-offset: 2px; }
  .rr:not(.rr-js) .rr-toggle { display: none; }
  .rr-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .rr-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--ca-accent), var(--ca-agent));
    transform-origin: 0 50%;
    transform: scaleX(1);
    will-change: transform;
  }
  .rr-js .rr-progress-bar { transform: scaleX(0); }

  .rr-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--ca-line);
  }
  .rr-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: color-mix(in srgb, var(--ca-bg) 82%, transparent);
  }
  .rr-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 14px 0;
    font-size: 12px;
    color: var(--ca-text-muted);
  }
  .rr-head-title { color: var(--ca-text-2); font-weight: 600; }
  .rr-head-tag { margin-left: auto; font: 11px var(--rr-mono); color: var(--ca-text-muted); background: none; padding: 0; }
  .rr-spot-name { font-family: var(--rr-mono); }
  .rr-body { padding: 10px 14px 14px; display: flex; flex-direction: column; min-height: 0; flex: 1; }

  /* The code: a line per row, its number in the gutter, a bar while it has tasks running. */
  .rr-pre {
    position: relative;
    margin: 0;
    padding: 10px 0 16px;
    overflow-x: auto;
    background: none;
    border: 0;
    font: 12px/1.65 var(--rr-mono);
    color: var(--ca-text);
    flex: 1;
  }
  .rr-pre:focus-visible { outline: var(--ca-focus-width) solid var(--ca-focus); outline-offset: -2px; }
  /*
   * A line is as wide as its code, and at least as wide as the pane. A line tasks are
   * created on ends with the count of those running: at the pane's right edge, or after
   * the code when the code reaches it, never over the code.
   */
  .rr-line {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem max-content 1fr;
    align-items: baseline;
    width: max-content;
    min-width: 100%;
    box-sizing: border-box;
    padding-right: 10px;
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .rr-line::before {
    content: '';
    position: absolute;
    inset: 0 0 0 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--ca-status-running) 22%, transparent), color-mix(in srgb, var(--ca-status-running) 4%, transparent) 70%);
    border-left: 2px solid var(--ca-status-running);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .rr-line.rr-live::before { opacity: 1; }
  .rr-js .rr-line:not(.rr-on) { opacity: 0; transform: translateX(-6px); }
  .rr-n { text-align: right; padding-right: 1rem; color: var(--ca-text-muted); opacity: 0.7; user-select: none; }
  .rr-gap .rr-n { opacity: 0.5; }
  .rr-line code { background: none; padding: 0; font: inherit; color: inherit; white-space: pre; }
  .rr-badge {
    justify-self: end;
    align-self: center;
    margin-left: 12px;
    /* One width for every count: the pill does not move as its text changes. */
    min-width: 5.4rem;
    box-sizing: border-box;
    text-align: center;
    padding: 0 7px;
    border-radius: 999px;
    /* No taller than a line of code: a line with a count is as tall as the others. */
    font: 600 10.5px/1.6 var(--sl-font, var(--sl-font-system));
    color: var(--ca-status-running);
    background: color-mix(in srgb, var(--ca-status-running) 14%, var(--ca-bg));
    border: 1px solid color-mix(in srgb, var(--ca-status-running) 45%, transparent);
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }
  .rr-badge:empty { opacity: 0; }
  .rr-code :global(.t-keyword) { color: var(--ca-code-keyword); }
  .rr-code :global(.t-string) { color: var(--ca-code-string); }
  .rr-code :global(.t-number) { color: var(--ca-code-number); }
  .rr-code :global(.t-constant) { color: var(--ca-code-constant); }
  .rr-code :global(.t-comment) { color: var(--ca-code-comment); }
  .rr-code :global(.t-function) { color: var(--ca-code-function); }
  .rr-code :global(.t-type) { color: var(--ca-code-type); }
  .rr-code :global(.t-name) { color: var(--ca-code-name); }

  .rr-graph .rr-body, .rr-transcript .rr-body { transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .rr-js:not(.rr-graph-on) .rr-graph .rr-body,
  .rr-js:not(.rr-graph-on) .rr-transcript .rr-body { opacity: 0; transform: translateY(10px) scale(0.985); }
  .rr-transcript .rr-body { overflow: hidden; }
  .rr-kpis .rr-body { justify-content: flex-start; }

  /* A narrow screen: the panes one under another, each as tall as it needs; the transcript a fixed height. */
  @media (max-width: 49.99rem) {
    .rr-graph .rr-body { min-height: 30rem; }
    .rr-transcript .rr-body { height: 21rem; }
  }

  /*
   * A wide screen: the whole window in one screen, under the site's header. It is
   * wider than the page's column (up to 90rem), and as tall as the screen less the
   * header and a margin. The code and the transcript side by side, each scrolling in
   * its own pane, the code's as wide as its lines (up to 46rem); under them a band:
   * the graph, its drawing fitted in it, and the numbers, a narrow column of two
   * columns of tiles (each its label and its value), so that the graph has most of the
   * window's width. The window is a container: the band's height is a share of the
   * window's, and more where the tiles' labels wrap in a wider font (the graph fits
   * whatever height the band has); a window narrower than 72rem has the graph across
   * it and the tiles in two rows under it.
   */
  @media (min-width: 50rem) {
    .rr-window {
      --rr-w: min(100vw - 3rem, 90rem);
      width: var(--rr-w);
      margin-inline: calc((100% - var(--rr-w)) / 2);
      height: clamp(30rem, 100svh - var(--sl-nav-height, 3.5rem) - 1.5rem, 62rem);
      display: flex;
      flex-direction: column;
      container: rr-window / size;
    }
    .rr-bar { flex: none; }
    .rr-grid {
      flex: 1;
      min-height: 0;
      grid-template-columns: fit-content(46rem) minmax(0, 1fr) 14.5rem;
      grid-template-rows: minmax(0, 1fr) minmax(clamp(22rem, 48cqh, 30rem), auto);
      grid-template-areas: 'code transcript transcript' 'graph graph kpis';
    }
    .rr-code { grid-area: code; }
    .rr-graph { grid-area: graph; }
    .rr-kpis { grid-area: kpis; }
    .rr-transcript { grid-area: transcript; }
    .rr-pane { min-height: 0; }
    /* The code's pane scrolls; its lines fade in and out at its edges. */
    .rr-pre {
      min-height: 0;
      overflow: auto;
      overscroll-behavior: contain;
      padding-bottom: 10px;
      -webkit-mask-image: linear-gradient(transparent, #000 10px, #000 calc(100% - 10px), transparent);
      mask-image: linear-gradient(transparent, #000 10px, #000 calc(100% - 10px), transparent);
    }
    .rr-transcript .rr-body, .rr-graph .rr-body { min-height: 0; }
    .rr-graph ca-pipeline-graph { flex: 1; min-height: 0; }
    /* The graph's name on the line of its outline, at the right: the drawing has that line's height. */
    .rr-graph { position: relative; contain: size; }
    .rr-graph .rr-head { position: absolute; top: 0; right: 0; z-index: 1; padding-top: 12px; }
    .rr-graph .rr-head-tag { margin-left: 0; }

    .rr-kpis .rr-body { padding: 6px 12px 10px; }
    .rr-kpis ca-kpis::part(tiles) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px; }
    .rr-kpis ca-kpis::part(tile) { padding: 5px 8px 6px; border-radius: 9px; }
    .rr-kpis ca-kpis::part(value) { font-size: 17px; margin-top: 1px; }
    .rr-kpis ca-kpis::part(sub), .rr-kpis ca-kpis::part(action) { display: none; }

    @container rr-window (max-width: 72rem) {
      .rr-grid {
        grid-template-columns: fit-content(56%) minmax(0, 1fr);
        grid-template-rows: minmax(0, 1fr) clamp(13rem, 44cqh, 24rem) auto;
        grid-template-areas: 'code transcript' 'graph graph' 'kpis kpis';
      }
      /* The numbers: the pane's name beside two rows of tiles. */
      .rr-kpis { flex-direction: row; align-items: center; }
      .rr-kpis .rr-head { flex: none; flex-direction: column; align-items: flex-start; gap: 2px; width: 6.5rem; padding: 0 0 0 14px; }
      .rr-kpis .rr-head-tag { margin-left: 0; }
      .rr-kpis .rr-body { flex: 1; min-width: 0; padding: 8px 14px 8px 4px; }
      .rr-kpis ca-kpis::part(tiles) { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .rr-kpis ca-kpis::part(value) { font-size: 20px; }
    }
  }

  /* The moments of the run, in the order they happened; with the replay, each lights as it happens. */
  .rr-moments {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem 1.25rem;
  }
  .rr-moment {
    margin: 0;
    padding: 0.6rem 0 0;
    border-top: 2px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
    color: var(--sl-color-gray-2);
    transition: opacity 0.4s ease, border-color 0.4s ease;
  }
  .rr-at { display: block; font: 600 var(--sl-text-xs) var(--rr-mono); color: var(--sl-color-gray-3); margin-bottom: 0.2rem; font-variant-numeric: tabular-nums; }
  .rr-js .rr-moment:not(.rr-past) { opacity: 0.4; }
  .rr-moment.rr-past { border-top-color: var(--sl-color-gray-3); }
  .rr-moment.rr-now { border-top-color: var(--sl-color-accent); color: var(--sl-color-white); }
  .rr-moment.rr-now .rr-at { color: var(--sl-color-text-accent); }

  @media (max-width: 40rem) {
    .rr-status { white-space: normal; }
    .rr-badge { display: none; }
    .rr-pre { font-size: 11.5px; }
    .rr-line { grid-template-columns: 2.4rem max-content 1fr; }
    .rr-n { padding-right: 0.6rem; }
    .rr-transcript .rr-body { height: 18rem; }
    .rr-graph .rr-body { min-height: 20rem; }
  }
  .rr-tabs { display: none; }

  /*
   * A narrow screen, once ./replay.ts has made the tabs (.rr-tabbed): the window is
   * one stage, most of the screen high. Under its bar, the tabs (code, graph,
   * transcript) and the panel they select, which follows the run until the reader
   * picks one; under the panel, the numbers in one row that scrolls sideways. The
   * moments are under the window, one per line.
   */
  @media (max-width: 49.99rem) {
    .rr { margin-bottom: 2.5rem; }
    .rr-title { font-size: var(--sl-text-xl); margin-bottom: 0.75rem; }

    .rr-tabbed .rr-window {
      height: clamp(28rem, 76svh, 42rem);
      display: flex;
      flex-direction: column;
    }
    .rr-tabbed .rr-bar { flex: none; padding: 4px 4px 4px 12px; gap: 8px; }
    .rr-tabbed .rr-status { white-space: nowrap; font-size: 11px; }
    /* The run's name is the section's title: the status keeps its state, its count and its clock. */
    .rr-tabbed .rr-status-run { display: none; }
    .rr-tabbed .rr-toggle { min-height: 44px; min-width: 44px; padding: 0 14px 0 30px; }

    .rr-tabbed .rr-tabs {
      flex: none;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2px;
      margin: 8px 10px 0;
      padding: 3px;
      border-radius: 12px;
      background: color-mix(in srgb, var(--ca-card) 80%, transparent);
      border: 1px solid var(--ca-line);
    }
    .rr-tabs [role='tab'] {
      min-height: 44px;
      border: 0;
      border-radius: 9px;
      background: none;
      color: var(--ca-text-2);
      font: 600 13px/1 var(--sl-font, var(--sl-font-system));
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    }
    .rr-tabs [role='tab'][aria-selected='true'] {
      color: var(--ca-text);
      background: var(--ca-raise);
      box-shadow: 0 1px 0 color-mix(in srgb, var(--ca-text) 8%, transparent) inset, 0 2px 8px -3px var(--ca-shadow);
    }
    .rr-tabs [role='tab']:focus-visible { outline: var(--ca-focus-width) solid var(--ca-focus); outline-offset: 1px; }

    .rr-tabbed .rr-grid { flex: 1; min-height: 0; display: flex; flex-direction: column; background: none; gap: 0; }
    .rr-tabbed .rr-pane { background: none; }
    .rr-tabbed .rr-pane:not(.rr-kpis):not(.rr-shown) { display: none; }
    .rr-tabbed .rr-shown { flex: 1; min-height: 0; animation: rr-panel-in 0.28s ease-out; }
    .rr-tabbed .rr-head { padding: 8px 14px 0; }
    /* The graph's tab names it: its drawing has the height its name took. */
    .rr-tabbed .rr-graph .rr-head { display: none; }
    .rr-tabbed .rr-body { min-height: 0; height: auto; flex: 1; }
    .rr-tabbed .rr-pre {
      min-height: 0;
      overflow: auto;
      overscroll-behavior: contain;
      padding: 6px 0 10px;
      -webkit-mask-image: linear-gradient(transparent, #000 10px, #000 calc(100% - 10px), transparent);
      mask-image: linear-gradient(transparent, #000 10px, #000 calc(100% - 10px), transparent);
    }
    /* The graph as tall as its drawing at the pane's width, at the scale the width allows: the pane scrolls. */
    .rr-tabbed .rr-graph .rr-body {
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-mask-image: linear-gradient(#000 calc(100% - 14px), transparent);
      mask-image: linear-gradient(#000 calc(100% - 14px), transparent);
    }
    .rr-tabbed .rr-graph ca-pipeline-graph { flex: none; }
    .rr-tabbed .rr-transcript .rr-body { overflow: hidden; }

    /* The numbers: one row of tiles, under the panel. */
    .rr-tabbed .rr-kpis { flex: none; order: 1; border-top: 1px solid var(--ca-line); }
    .rr-tabbed .rr-kpis .rr-head { display: none; }
    .rr-tabbed .rr-kpis .rr-body {
      padding: 8px 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent);
    }
    .rr-tabbed .rr-kpis .rr-body:focus-visible { outline: var(--ca-focus-width) solid var(--ca-focus); outline-offset: -2px; }
    .rr-tabbed .rr-kpis ca-kpis { width: max-content; }
