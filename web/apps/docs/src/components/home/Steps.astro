---
// The landing page's path, from installing the package to a run in the monitor.
interface Step { title: string; text: string; commands: string[]; link?: { href: string; text: string } }

const steps: Step[] = [
  {
    title: 'Install',
    text: 'Linux, Python 3.12 or later, and one or more coding agents on PATH.',
    commands: ["uv add 'contraagent[monitor]'"],
    link: { href: '/python/#install', text: 'Install' },
  },
  {
    title: 'Write the tasks',
    text: 'In tasks.py: the pydantic models, the agent tasks, the Python tasks and the flow. A plugin holds how the coding agent does each agent task, a role per kind.',
    commands: ['contraagent plugin new plugins/docs'],
    link: { href: '/python/tasks/', text: 'Tasks and flows' },
  },
  {
    title: 'Check',
    text: 'Every problem before anything launches, then the whole flow on a stub agent.',
    commands: [`contraagent check tasks.py:docs --kwargs '{"units": ["alpha"]}'`, `contraagent run tasks.py:docs --stub --kwargs '{"units": ["alpha"]}'`],
    link: { href: '/python/testing/', text: 'Checking and testing' },
  },
  {
    title: 'Run',
    text: 'On the coding agent and model that pipeline.toml names for each kind of task.',
    commands: [`contraagent run tasks.py:docs --config pipeline.toml --kwargs '{"units": ["alpha"]}'`],
    link: { href: '/python/routing/', text: 'Routing and credentials' },
  },
  {
    title: 'Monitor',
    text: 'The runs, live, in a browser: the graph, each transcript, the checks and the history.',
    commands: ['contraagent monitor --runs-dir runs'],
    link: { href: '/python/monitor/', text: 'The monitor' },
  },
];
---

<ol class="steps not-content">
  {
    steps.map((s, i) => (
      <li class="step">
        <span class="step-n" aria-hidden="true">{i + 1}</span>
        <div class="step-words">
          <h3 class="step-title">{s.title}</h3>
          <p class="step-text">{s.text}</p>
          {s.link && <a class="step-link" href={s.link.href}>{s.link.text}</a>}
        </div>
        <div class="step-cmds">{s.commands.map((c) => <code class="step-cmd">{c}</code>)}</div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .step {
    position: relative;
    margin: 0;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.75rem;
    padding: 0 0 1.75rem;
  }
  .step-n {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    font: 600 var(--sl-text-sm) var(--sl-font-mono, var(--sl-font-system-mono));
    color: var(--sl-color-text-accent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 12%, var(--sl-color-black));
  }
  .step-words { display: flex; flex-direction: column; gap: 0.3rem; padding-top: 0.2rem; }
  .step-title { margin: 0; font-size: var(--sl-text-lg); line-height: 1.3; color: var(--sl-color-white); }
  .step-text { margin: 0; font-size: var(--sl-text-sm); line-height: 1.55; color: var(--sl-color-gray-2); max-width: 32rem; }
  .step-link { font-size: var(--sl-text-sm); color: var(--sl-color-text-accent); }
  .step-cmds { grid-column: 2; display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .step-cmd {
    display: block;
    font: var(--sl-text-sm) / 1.5 var(--sl-font-mono, var(--sl-font-system-mono));
    padding: 0.55rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  .step-cmd::before { content: '$ '; color: var(--sl-color-gray-3); user-select: none; }
  @media (min-width: 60rem) {
    .step { grid-template-columns: 2.25rem minmax(0, 0.9fr) minmax(0, 1.25fr); column-gap: 1.5rem; }
    .step-cmds { grid-column: 3; padding-top: 0.15rem; }
  }
</style>
