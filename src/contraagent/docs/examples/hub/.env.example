# Settings for compose.yaml. `make-tokens` copies this file to .env with new passwords;
# a variable set in the environment overrides the one here.

# The version of contraagent the hub's image installs: the version this directory came
# with. A host that runs pipelines with a relay runs this version too (`contraagent --version`).
CONTRAAGENT_VERSION=0.2.0
# A wheel in this directory to install in place of the one on PyPI, by its file name
# (for example contraagent-0.2.0-py3-none-any.whl); empty: PyPI.
CONTRAAGENT_WHEEL=

# The port the hub is published on, and the address of this host it is bound to.
CONTRAAGENT_HUB_PORT=8790
CONTRAAGENT_HUB_BIND=0.0.0.0
# The host name relays and browsers reach the hub by (`contraagent hub --allow-host`).
CONTRAAGENT_HUB_HOSTNAME=hub.example.internal
# Days the hub keeps a run after its last activity (`contraagent hub --retain-days`);
# empty: every run is kept.
CONTRAAGENT_RETENTION_DAYS=30
# The password of the hub's Postgres user.
POSTGRES_PASSWORD=change-me
# RustFS's access key and secret key; the hub uses them for its bucket.
RUSTFS_ACCESS_KEY=contraagent
RUSTFS_SECRET_KEY=change-me
