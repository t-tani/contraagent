{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "One line of `rests.jsonl` in a run directory of run format 1.",
  "additionalProperties": true,
  "description": "One line of `rests.jsonl`: `event` `start` when the credential began resting (with\nits rest), `end` when it was found not resting again (with the rest that ended).",
  "properties": {
    "credential": {
      "title": "Credential",
      "type": "string"
    },
    "window": {
      "default": "",
      "enum": [
        "",
        "five_hour",
        "seven_day"
      ],
      "title": "Window",
      "type": "string"
    },
    "pct": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pct"
    },
    "cap": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cap"
    },
    "rule": {
      "default": "",
      "title": "Rule",
      "type": "string"
    },
    "until": {
      "default": "",
      "title": "Until",
      "type": "string"
    },
    "account": {
      "default": "",
      "title": "Account",
      "type": "string"
    },
    "reading": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reading"
    },
    "ts": {
      "title": "Ts",
      "type": "string"
    },
    "event": {
      "enum": [
        "start",
        "end"
      ],
      "title": "Event",
      "type": "string"
    }
  },
  "required": [
    "credential",
    "ts",
    "event"
  ],
  "title": "RestEvent",
  "type": "object"
}
