              "type": "number"
            }
          ],
          "title": "Stall S"
        },
        "context_budget": {
          "type": "integer",
          "title": "Context Budget"
        },
        "context_warn_pct": {
          "maximum": 99,
          "minimum": 1,
          "type": "integer",
          "title": "Context Warn Pct"
        },
        "max_denials": {
          "type": "integer",
          "title": "Max Denials"
        },
        "max_concurrent": {
          "type": "integer",
          "title": "Max Concurrent"
        },
        "retries": {
          "type": "integer",
          "title": "Retries"
        },
        "retry_backoff_base": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Retry Backoff Base"
        }
      },
      "title": "TaskTable",
      "type": "object"
    },
    "Vertex": {
      "additionalProperties": false,
      "description": "Google Vertex AI. `credentials_file` may be a service-account key or a workload\nidentity federation (`external_account`) config.",
