{
  "openapi": "3.1.0",
  "info": {
    "title": "contraagent hub ingest",
    "description": "How a relay ships a host's runs to a contraagent hub. A POST or PUT body may be sent with `Content-Encoding: gzip`; the size caps apply after it is undone.",
    "version": "1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "Whether the record store, the blob store and the transcripts each answer a trivial\nread; no token. 200 when all do, 503 naming the ones that do not.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "a store did not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ingest/records": {
      "post": {
        "summary": "Records",
        "description": "Store a batch of one run's records; how many lines of each log it named the hub holds.",
        "operationId": "records_ingest_records_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "401": {
            "description": "no ingest token, or not one the hub was given"
          },
          "413": {
            "description": "the body is larger than the hub takes"
          },
          "403": {
            "description": "the token was given for another host"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/ingest/heartbeat": {
      "post": {
        "summary": "Heartbeat",
        "description": "Keep a host's latest heartbeat; how long the hub counts the host as up without another.",
        "operationId": "heartbeat_ingest_heartbeat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Heartbeat"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatAck"
                }
              }
            }
          },
          "401": {
            "description": "no ingest token, or not one the hub was given"
          },
          "413": {
            "description": "the body is larger than the hub takes"
          },
          "403": {
            "description": "the token was given for another host"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/ingest/blobs/{sha256}": {
      "head": {
        "summary": "Has Blob",
        "description": "Whether the hub holds the content named by `sha256`.",
        "operationId": "has_blob_ingest_blobs__sha256__head",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sha256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the hub holds that content"
          },
          "404": {
            "description": "it does not"
          },
          "401": {
            "description": "no ingest token, or not one the hub was given"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Put Blob",
        "description": "Store the raw body as the content named by `sha256`, its SHA-256 in hex.",
        "operationId": "put_blob_ingest_blobs__sha256__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sha256"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "stored"
          },
          "400": {
            "description": "the body does not hash to `sha256`"
          },
          "401": {
            "description": "no ingest token, or not one the hub was given"
          },
          "413": {
            "description": "the body is larger than the hub takes"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "logs": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Logs",
            "default": {}
          },
          "durable": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Durable",
            "default": {}
          }
        },
        "type": "object",
        "title": "Accepted",
        "description": "How many lines the hub holds of each log the batch named, after storing it, and how\nmany of those are durable (in object storage or the database, so a hub that loses its\nown disk still has them). A relay resends from `logs`; lines past `durable` are on the\nhub's disk only."
      },
      "DocumentPut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "the document's layout name: `run.json`, `contracts/<name>.json`, `inflight/<key>.json`, ..."
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "the document's text; null when it was removed"
          }
        },
        "type": "object",
        "required": [
          "name",
          "text"
        ],
        "title": "DocumentPut",
        "description": "A whole document of the run, or its removal."
      },
      "FileRef": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "the path as the contract names it"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256",
            "description": "the content's SHA-256 (the blob's name); null when the file does not exist"
          },
          "size": {
            "type": "integer",
            "title": "Size",
            "default": 0
          },
          "mtime": {
            "type": "string",
            "title": "Mtime",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "title": "FileRef",
        "description": "A file one of the run's contracts names, as the run's host sees it."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failing"
            ],
            "title": "Status"
          },
          "failed": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Failed",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health",
        "description": "Whether each of the hub's stores answered a trivial read: `ok` when all did, else\n`failing` with the stores that did not (`records`, `blobs`, `transcripts`) and the\nkind of error each raised."
      },
      "Heartbeat": {
        "properties": {
          "host_id": {
            "type": "string",
            "title": "Host Id"
          },
          "sent_at": {
            "type": "string",
            "title": "Sent At",
            "description": "the host's clock, ISO 8601"
          },
          "interval_s": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Interval S",
            "description": "seconds until the next heartbeat"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunLiveness"
            },
            "type": "array",
            "title": "Runs",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "host_id",
          "sent_at",
          "interval_s"
        ],
        "title": "Heartbeat",
        "description": "A host says it is up, and what its runs are doing."
      },
      "HeartbeatAck": {
        "properties": {
          "ttl_s": {
            "type": "number",
            "title": "Ttl S"
          }
        },
        "type": "object",
        "required": [
          "ttl_s"
        ],
        "title": "HeartbeatAck",
        "description": "How long the hub counts the host as up without another heartbeat."
      },
      "LogChunk": {
        "properties": {
          "log": {
            "type": "string",
            "title": "Log",
            "description": "the log's layout name: `journal.jsonl`, `streams/<key>.stream.jsonl`, ..."
          },
          "offset": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Offset",
            "description": "the line index of `lines[0]` in the log"
          },
          "lines": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lines",
            "description": "complete lines, without their newline"
          }
        },
        "type": "object",
        "required": [
          "log",
          "offset",
          "lines"
        ],
        "title": "LogChunk",
        "description": "Complete lines of one append-only log, from line `offset` on."
      },
      "RecordBatch": {
        "properties": {
          "run": {
            "$ref": "#/components/schemas/RunRef"
          },
          "logs": {
            "items": {
              "$ref": "#/components/schemas/LogChunk"
            },
            "type": "array",
            "title": "Logs",
            "default": []
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentPut"
            },
            "type": "array",
            "title": "Documents",
            "default": []
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileRef"
            },
            "type": "array",
            "title": "Files",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "run"
        ],
        "title": "RecordBatch",
        "description": "What changed in one run since the relay last sent it."
      },
      "RunLiveness": {
        "properties": {
          "run": {
            "$ref": "#/components/schemas/RunRef"
          },
          "alive": {
            "type": "boolean",
            "title": "Alive"
          },
          "snapshot": {
            "additionalProperties": true,
            "type": "object",
            "title": "Snapshot",
            "description": "the run's live processes, in `Liveness.snapshot`'s shape (`contraagent.monitor.Liveness`)"
          }
        },
        "type": "object",
        "required": [
          "run",
          "alive",
          "snapshot"
        ],
        "title": "RunLiveness",
        "description": "One run the host drives, as its heartbeat reports it."
      },
      "RunRef": {
        "properties": {
          "host_id": {
            "type": "string",
            "title": "Host Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "run_uid": {
            "type": "string",
            "title": "Run Uid"
          }
        },
        "type": "object",
        "required": [
          "host_id",
          "run_id",
          "run_uid"
        ],
        "title": "RunRef",
        "description": "Which run a batch or a liveness report is about."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "an ingest token the hub was given",
        "scheme": "bearer"
      }
    }
  }
}
